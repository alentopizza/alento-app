# PostgreSQL interno de EasyPanel
DATABASE_URL="postgresql://alento_app:CAMBIAR_CONTRASENA@app_alento_alento-db:5432/alento?schema=public"

# Aplicación
NEXT_PUBLIC_APP_NAME="Alentó POS"

# Rappi Open Orders / Integrations Manager
# Completar únicamente cuando Rappi entregue credenciales técnicas oficiales.
# NO usar aquí el usuario ni la contraseña de Rappi Partners.
RAPPI_CLIENT_ID=""
RAPPI_CLIENT_SECRET=""
# Dominio/base URL asignado por Rappi para sandbox o producción.
RAPPI_API_BASE_URL=""
RAPPI_WEBHOOK_SECRET=""

# Rappi merchant authorization flow (popup login -> select store)
# These values must be issued/approved by Rappi for Alentó as an integration.
RAPPI_OAUTH_CLIENT_ID=""
RAPPI_OAUTH_CLIENT_SECRET=""
RAPPI_OAUTH_AUTHORIZE_URL=""
RAPPI_OAUTH_TOKEN_URL=""
RAPPI_OAUTH_STORES_URL=""
RAPPI_OAUTH_CALLBACK_URL="https://pos.alentopizza.com/api/integrations/rappi/oauth/callback"
RAPPI_OAUTH_SCOPE=""
RAPPI_OAUTH_AUDIENCE=""
