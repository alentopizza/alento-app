# PostgreSQL interno de EasyPanel
DATABASE_URL="postgresql://alento_app:CAMBIAR_CONTRASENA@app_alento_alento-db:5432/alento?schema=public"

# Aplicación
NEXT_PUBLIC_APP_NAME="Alentó POS"

# Autenticación
# Generar valores aleatorios fuertes y distintos para producción.
AUTH_SESSION_SECRET="CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_MINIMO_32_CARACTERES"
AUTH_BOOTSTRAP_KEY="CAMBIAR_POR_CLAVE_TEMPORAL_PARA_PRIMER_ADMIN"

# WhatsApp Cloud API - login de clientes por OTP
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION="v25.0"
WHATSAPP_AUTH_TEMPLATE_NAME="authentication_code_copy_code_button"
WHATSAPP_AUTH_LANGUAGE_CODE="es"

# Solo desarrollo local: permite imprimir el OTP en logs si WhatsApp no está configurado.
# Nunca activar en producción.
WHATSAPP_DEV_LOG_OTP="0"
