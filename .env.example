# PostgreSQL interno de EasyPanel
DATABASE_URL="postgresql://alento_app:CAMBIAR_CONTRASENA@app_alento_alento-db:5432/alento?schema=public"

# Aplicación
NEXT_PUBLIC_APP_NAME="Alentó POS"
NEXT_PUBLIC_APP_URL="https://alentopizza.com"

# Autenticación
# Generar valores aleatorios fuertes y distintos para producción.
AUTH_SESSION_SECRET="CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_MINIMO_32_CARACTERES"
AUTH_BOOTSTRAP_KEY="CAMBIAR_POR_CLAVE_TEMPORAL_PARA_PRIMER_ADMIN"

# EXTENSIÓN ALENTÓ — OTP de clientes mediante escenario externo de Make/WhatsApp.
# No es requisito del núcleo genérico. Guardar la URL real únicamente en EasyPanel.
MAKE_WHATSAPP_OTP_WEBHOOK_URL=""


# EXTENSIÓN ALENTÓ — Dashboard App de Chatwoot.
# No es requisito del núcleo genérico.
CHATWOOT_DASHBOARD_KEY=""


# EXTENSIÓN ALENTÓ — microservicio de notificaciones Meta/WhatsApp.
# La app principal solo envía eventos simples al notifier y debe poder operar sin él.
NOTIFIER_WEBHOOK_URL="https://notifier.example.com/events"
NOTIFIER_SHARED_SECRET="CAMBIAR_POR_SECRETO_ALEATORIO"

# Seguimiento público de pedidos
# Se usa para firmar URLs no predecibles como /seguimiento/<token>.
ORDER_TRACKING_SECRET="CAMBIAR_POR_SECRETO_ALEATORIO_DE_MINIMO_32_CARACTERES"


# Google Maps Platform — checkout público
# Clave pública: restringir por HTTP referrer al dominio de Alentó.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Clave privada de servidor: Routes/Geocoding. Nunca exponer al navegador.
GOOGLE_MAPS_SERVER_API_KEY=""

# Web Push para repartidores
# Genera las claves con: npm run push:keys
WEB_PUSH_VAPID_SUBJECT="mailto:admin@alentopizza.com"
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""

# Firebase Cloud Messaging — APK oficial Repartidor 004
# Configuración pública de la app Android en Firebase.
FIREBASE_ANDROID_API_KEY=""
FIREBASE_ANDROID_APP_ID=""
FIREBASE_PROJECT_ID=""
FIREBASE_MESSAGING_SENDER_ID=""

# Cuenta de servicio Firebase completa en JSON, SOLO servidor.
# Guardar el valor real únicamente en EasyPanel/secret manager.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Rappi Public API / integración POS
# Mantener deshabilitado hasta que Rappi entregue credenciales y webhook secret.
RAPPI_ENABLED="false"
# sandbox usa api.dev.rappi.com; production usa api.rappi.com.co
RAPPI_ENVIRONMENT="sandbox"
# Opcional: sobrescribe el dominio derivado del ambiente.
RAPPI_API_BASE_URL=""
RAPPI_STORE_ID="900489414"
RAPPI_CLIENT_ID=""
RAPPI_CLIENT_SECRET=""
RAPPI_WEBHOOK_SECRET=""
# false = el pedido entra como CONFIRMED y se acepta desde Estados.
# true = se toma automáticamente al recibirlo.
RAPPI_AUTO_ACCEPT="false"
# Tipo de rechazo habilitado por Rappi. Dejar vacío hasta homologación.
RAPPI_REJECT_CANCEL_TYPE=""

