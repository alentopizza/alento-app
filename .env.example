# PostgreSQL interno de EasyPanel
DATABASE_URL="postgresql://alento_app:CAMBIAR_CONTRASENA@app_alento_alento-db:5432/alento?schema=public"

# Aplicación
NEXT_PUBLIC_APP_NAME="Alentó POS"

# Autenticación
# Generar valores aleatorios fuertes y distintos para producción.
AUTH_SESSION_SECRET="CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_MINIMO_32_CARACTERES"
AUTH_BOOTSTRAP_KEY="CAMBIAR_POR_CLAVE_TEMPORAL_PARA_PRIMER_ADMIN"

# Entrega de OTP de clientes mediante escenario de Make.
# Guardar la URL real únicamente en EasyPanel; no subirla al repositorio.
MAKE_WHATSAPP_OTP_WEBHOOK_URL=""


# Integración de Dashboard App de Chatwoot.
# Generar una clave aleatoria fuerte y guardarla solo en EasyPanel/Chatwoot.
CHATWOOT_DASHBOARD_KEY=""


# Chatwoot / WhatsApp notifications
CHATWOOT_BASE_URL="https://chat.operadoranordecolombia.com"
CHATWOOT_ACCOUNT_ID="1"
CHATWOOT_WHATSAPP_INBOX_ID="13"
CHATWOOT_API_ACCESS_TOKEN=""
CHATWOOT_ORDER_CREATED_TEMPLATE_NAME=""
CHATWOOT_ORDER_CREATED_TEMPLATE_LANGUAGE="es"
CHATWOOT_ORDER_CREATED_TEMPLATE_CATEGORY="UTILITY"
# JSON object mapping template variables. Available tokens:
# {{customer_name}}, {{order_code}}, {{total}}, {{fulfillment_type}}, {{phone}}
# Example: {"1":"{{customer_name}}","2":"{{order_code}}","3":"{{total}}"}
CHATWOOT_ORDER_CREATED_TEMPLATE_BODY_PARAMS="{\"1\":\"{{customer_name}}\",\"2\":\"{{order_code}}\",\"3\":\"{{total}}\"}"


# Seguimiento público de pedidos
# Se usa para firmar URLs no predecibles como /seguimiento/<token>.
ORDER_TRACKING_SECRET="CAMBIAR_POR_SECRETO_ALEATORIO_DE_MINIMO_32_CARACTERES"

# Plantilla nuevo_pedido_v2
CHATWOOT_ORDER_CREATED_TEMPLATE_HEADER_IMAGE_URL="https://storage.googleapis.com/glide-prod.appspot.com/uploads-v2/ka91FhewP8WCQ2jD9VzF/pub/arG6qTss0Dye7zuwPYrR.png"
CHATWOOT_ORDER_CREATED_TEMPLATE_BUTTON_PARAM="{{tracking_path}}"
