generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PREPARING
  PREPARED
  READY
  OUT_FOR_DELIVERY
  ARRIVED
  DELIVERED
  COMPLETED
  CANCELED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  STORE
}

enum OrderSource {
  POS
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WEB
  RAPPI
  DIDI
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  CANCELED
}

enum ProductType {
  STANDARD
  PIZZA_SINGLE
  PIZZA_TWO_FLAVORS
  COMBO
  MODIFIER
  INTERNAL
}

enum CouponType {
  FIXED
  PERCENTAGE
}

enum UserRole {
  ADMIN
  POS
  KITCHEN
  CASHIER
  DISPATCH
}

model Customer {
  id          Int               @id @default(autoincrement())
  name        String
  countryCode String            @default("+57")
  phone       String?           @unique
  email       String?           @unique
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  addresses   CustomerAddress[]
  orders      Order[]
  account     CustomerAccount?
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  roles        UserRole[] @default([])
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([active])
}

model CustomerAccount {
  id              Int       @id @default(autoincrement())
  customerId      Int       @unique
  phoneE164       String    @unique
  phoneVerifiedAt DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerAuthCode {
  id          String    @id @default(cuid())
  phoneE164   String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phoneE164, createdAt])
  @@index([expiresAt])
}

model CustomerAddress {
  id           Int      @id @default(autoincrement())
  customerId   Int
  label        String?
  address      String
  neighborhood String?
  city         String?  @default("Bogotá")
  notes        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([customerId])
}

model Category {
  id           Int       @id @default(autoincrement())
  name         String
  slug         String    @unique
  imageUrl     String?
  active       Boolean   @default(true)
  visibleInPos Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id                  Int                      @id @default(autoincrement())
  categoryId          Int
  name                String
  description         String?
  imageUrl            String?
  imageUrl2           String?
  type                ProductType              @default(STANDARD)
  basePrice           Decimal?                 @db.Decimal(12, 2)
  comboDiscount       Decimal?                 @db.Decimal(12, 2)
  couponEligible      Boolean                  @default(true)
  active              Boolean                  @default(true)
  visibleInPos        Boolean                  @default(true)
  featured            Boolean                  @default(false)
  sortOrder           Int                      @default(0)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  category            Category                 @relation(fields: [categoryId], references: [id])
  variants            ProductVariant[]
  orderItems          OrderItem[]
  comboGroups         ComboGroup[]             @relation("ComboProductGroups")
  comboOptions        ComboOption[]            @relation("ComboOptionProduct")
  comboPizzaRules     ComboPizzaRule[]         @relation("ComboPizzaProduct")
  comboFlavorOptions  ComboPizzaFlavorOption[] @relation("ComboFlavorProduct")

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([type])
  @@index([visibleInPos, active])
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  productId  Int
  name       String
  sku        String?     @unique
  price      Decimal     @db.Decimal(12, 2)
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model PizzaSize {
  id               Int                    @id @default(autoincrement())
  name             String                 @unique
  diameterCm       Int
  basePrice        Decimal                @db.Decimal(12, 2)
  active           Boolean                @default(true)
  sortOrder        Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  crustPrices      PizzaCrustPrice[]
  comboSizeOptions ComboPizzaSizeOption[]
}

model PizzaCrust {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  prices    PizzaCrustPrice[]
}

model PizzaCrustPrice {
  id        Int        @id @default(autoincrement())
  crustId   Int
  sizeId    Int
  price     Decimal    @db.Decimal(12, 2)
  crust     PizzaCrust @relation(fields: [crustId], references: [id], onDelete: Cascade)
  size      PizzaSize  @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([crustId, sizeId])
  @@index([sizeId])
}

model ComboPizzaRule {
  id             Int                      @id @default(autoincrement())
  comboProductId Int
  quantity       Int                      @default(1)
  sortOrder      Int                      @default(0)
  comboProduct   Product                  @relation("ComboPizzaProduct", fields: [comboProductId], references: [id], onDelete: Cascade)
  sizes          ComboPizzaSizeOption[]
  flavors        ComboPizzaFlavorOption[]

  @@index([comboProductId])
}

model ComboPizzaSizeOption {
  id     Int            @id @default(autoincrement())
  ruleId Int
  sizeId Int
  rule   ComboPizzaRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  size   PizzaSize      @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([ruleId, sizeId])
  @@index([sizeId])
}

model ComboPizzaFlavorOption {
  id        Int            @id @default(autoincrement())
  ruleId    Int
  productId Int
  rule      ComboPizzaRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  product   Product        @relation("ComboFlavorProduct", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([ruleId, productId])
  @@index([productId])
}

model ComboGroup {
  id             Int           @id @default(autoincrement())
  comboProductId Int
  kind           String        @default("CUSTOM")
  name           String
  minSelections  Int           @default(1)
  maxSelections  Int           @default(1)
  sortOrder      Int           @default(0)
  comboProduct   Product       @relation("ComboProductGroups", fields: [comboProductId], references: [id], onDelete: Cascade)
  options        ComboOption[]

  @@index([comboProductId])
}

model ComboOption {
  id         Int        @id @default(autoincrement())
  groupId    Int
  productId  Int
  quantity   Int        @default(1)
  priceDelta Decimal    @default(0) @db.Decimal(12, 2)
  sortOrder  Int        @default(0)
  group      ComboGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  product    Product    @relation("ComboOptionProduct", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([groupId, productId])
  @@index([productId])
}

model Coupon {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  type      CouponType
  value     Decimal    @db.Decimal(12, 2)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]
}

model OrderSequence {
  id        Int      @id @default(1)
  current   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Order {
  id               Int               @id @default(autoincrement())
  sequenceNumber   Int?              @unique
  customerId       Int?
  addressId        Int?
  couponId         Int?
  couponName       String?
  deliveryZoneId   String?
  deliveryZoneName String?
  discountSource   String            @default("NONE")
  status           OrderStatus       @default(DRAFT)
  fulfillmentType  FulfillmentType   @default(DELIVERY)
  source           OrderSource       @default(POS)
  subtotal         Decimal           @default(0) @db.Decimal(12, 2)
  deliveryFee      Decimal           @default(0) @db.Decimal(12, 2)
  discount         Decimal           @default(0) @db.Decimal(12, 2)
  total            Decimal           @default(0) @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  address          CustomerAddress?  @relation(fields: [addressId], references: [id], onDelete: SetNull)
  coupon           Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]

  @@index([customerId])
  @@index([addressId])
  @@index([couponId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id               Int             @id @default(autoincrement())
  orderId          Int
  productId        Int?
  variantId        Int?
  productName      String
  variantName      String?
  unitPrice        Decimal         @db.Decimal(12, 2)
  quantity         Int             @default(1)
  preparedQuantity Int             @default(0)
  lineTotal        Decimal         @db.Decimal(12, 2)
  configuration    Json?
  notes            String?
  createdAt        DateTime        @default(now())
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id           Int           @id @default(autoincrement())
  orderId      Int
  method       String
  amount       Decimal       @db.Decimal(12, 2)
  cashReceived Decimal?      @db.Decimal(12, 2)
  changeDue    Decimal?      @db.Decimal(12, 2)
  status       PaymentStatus @default(PENDING)
  reference    String?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, paidAt])
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}