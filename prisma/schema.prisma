generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  STORE
}

enum OrderSource {
  POS
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WEB
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  CANCELED
}

enum ProductType {
  STANDARD
  PIZZA_SINGLE
  PIZZA_TWO_FLAVORS
  COMBO
  MODIFIER
  INTERNAL
}

model Customer {
  id          Int               @id @default(autoincrement())
  name        String
  countryCode String            @default("+57")
  phone       String?           @unique
  email       String?           @unique
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  addresses   CustomerAddress[]
  orders      Order[]
}

model CustomerAddress {
  id           Int      @id @default(autoincrement())
  customerId   Int
  label        String?
  address      String
  neighborhood String?
  city         String?  @default("Bogotá")
  notes        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([customerId])
}

model Category {
  id           Int       @id @default(autoincrement())
  name         String
  slug         String    @unique
  imageUrl     String?
  active       Boolean   @default(true)
  visibleInPos Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id             Int              @id @default(autoincrement())
  categoryId     Int
  name           String
  description    String?
  imageUrl       String?
  imageUrl2      String?
  type           ProductType      @default(STANDARD)
  basePrice      Decimal?         @db.Decimal(12, 2)
  active         Boolean          @default(true)
  visibleInPos   Boolean          @default(true)
  featured       Boolean          @default(false)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  category       Category         @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  orderItems     OrderItem[]
  comboGroups    ComboGroup[]     @relation("ComboProductGroups")
  comboOptions   ComboOption[]    @relation("ComboOptionProduct")

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([type])
  @@index([visibleInPos, active])
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  productId  Int
  name       String
  sku        String?     @unique
  price      Decimal     @db.Decimal(12, 2)
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model PizzaSize {
  id         Int               @id @default(autoincrement())
  name       String            @unique
  diameterCm Int
  basePrice  Decimal           @db.Decimal(12, 2)
  active     Boolean           @default(true)
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  crustPrices PizzaCrustPrice[]
}

model PizzaCrust {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  prices    PizzaCrustPrice[]
}

model PizzaCrustPrice {
  id        Int        @id @default(autoincrement())
  crustId   Int
  sizeId    Int
  price     Decimal    @db.Decimal(12, 2)
  crust     PizzaCrust @relation(fields: [crustId], references: [id], onDelete: Cascade)
  size      PizzaSize  @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([crustId, sizeId])
  @@index([sizeId])
}

model ComboGroup {
  id            Int           @id @default(autoincrement())
  comboProductId Int
  name          String
  minSelections Int           @default(1)
  maxSelections Int           @default(1)
  sortOrder     Int           @default(0)
  comboProduct  Product       @relation("ComboProductGroups", fields: [comboProductId], references: [id], onDelete: Cascade)
  options       ComboOption[]

  @@index([comboProductId])
}

model ComboOption {
  id         Int        @id @default(autoincrement())
  groupId    Int
  productId  Int
  quantity   Int        @default(1)
  priceDelta Decimal    @default(0) @db.Decimal(12, 2)
  sortOrder  Int        @default(0)
  group      ComboGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  product    Product    @relation("ComboOptionProduct", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([groupId, productId])
  @@index([productId])
}

model Order {
  id              Int               @id @default(autoincrement())
  customerId      Int?
  addressId       Int?
  status          OrderStatus       @default(DRAFT)
  fulfillmentType FulfillmentType   @default(DELIVERY)
  source          OrderSource       @default(POS)
  subtotal        Decimal           @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal           @default(0) @db.Decimal(12, 2)
  discount        Decimal           @default(0) @db.Decimal(12, 2)
  total           Decimal           @default(0) @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  address         CustomerAddress?  @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]

  @@index([customerId])
  @@index([addressId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            Int             @id @default(autoincrement())
  orderId       Int
  productId     Int?
  variantId     Int?
  productName   String
  variantName   String?
  unitPrice     Decimal         @db.Decimal(12, 2)
  quantity      Int             @default(1)
  lineTotal     Decimal         @db.Decimal(12, 2)
  configuration Json?
  notes         String?
  createdAt     DateTime        @default(now())
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id        Int           @id @default(autoincrement())
  orderId   Int
  method    String
  amount    Decimal       @db.Decimal(12, 2)
  status    PaymentStatus @default(PENDING)
  reference String?
  createdAt DateTime      @default(now())
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
