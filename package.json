{
  "name": "alento-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "prisma db push && next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "catalog:seed": "node scripts/seed-catalog.js",
    "push:keys": "web-push generate-vapid-keys",
    "drivers:backfill-earnings": "node scripts/backfill-driver-earnings.js",
    "ingredients:backfill-groups": "node scripts/backfill-ingredient-groups.js"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.24",
    "opentype.js": "^1.3.4",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "sharp": "^0.34.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.12",
    "@types/node": "22.18.1",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/web-push": "^3.6.4",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.24",
    "prisma": "6.15.0",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
